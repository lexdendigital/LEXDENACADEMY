{
  "name": "lexdenacademy-assessments",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/health"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
